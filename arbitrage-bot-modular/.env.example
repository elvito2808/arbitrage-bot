# Required by the current Zilliqa + KuCoin runtime. Replace locally; do not commit .env.
# Live submission is denied unless explicitly enabled. Never enable before reviewing
# LIVE_SAFETY_CHECKLIST.md and the deployment report.
LIVE_TRADING_ENABLED=false
METAMASK_PRIVATE_KEY=replace_locally
KUCOIN_API_KEY=replace_locally
KUCOIN_API_SECRET=replace_locally
KUCOIN_API_PASSPHRASE=replace_locally

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Provider selection defaults to the migrated built-ins.
ARBITRAGE_NETWORK_ID=zilliqa
ARBITRAGE_EXCHANGE_ID=kucoin
ARBITRAGE_DEX_ID=plunderswap

# Optional comma-separated import paths for local modules exposing
# register_providers(network_adapters=..., exchange_adapters=..., dex_adapters=).
ARBITRAGE_PROVIDER_MODULES=
